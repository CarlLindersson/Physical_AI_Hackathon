# Environment Configuration for QArmMini Trash Sorting
# Copy this file to .env and fill in your actual values

# Roboflow Configuration
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=6fuEkn2CDg3leS8F0O8j
ROBOFLOW_WORKSPACE_NAME=eshitas-workspace-gas5f
ROBOFLOW_WORKFLOW_ID=qarm-trash-ensemble-detection-1779037824337

# QArmMini Serial Connection (Mac/Linux format)
# On macOS: /dev/tty.usbserial-* or /dev/tty.SLAB_USBtoUART
# On Linux: /dev/ttyUSB0, /dev/ttyUSB1
# On Windows: COM3, COM4, etc.
QARM_SERIAL_PORT=/dev/ttyUSB0
QARM_BAUD_RATE=115200

# Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Detection Settings
CONFIDENCE_THRESHOLD=0.5
USE_ROBOT=true
DEBUG_MODE=false
